+
+/* --- the shape of a week -------------------------------------------------- */
+.rhythm{list-style:none;display:grid;gap:0;counter-reset:none}
+.rh-day{position:relative;--rh-color:var(--lav)}
+.rh-day.kind-deliver{--rh-color:var(--gold)}
+.rh-day.kind-talk{--rh-color:#7fd1e8}
+.rh-day.kind-status{--rh-color:var(--lav)}
+.rh-day.kind-challenge{--rh-color:#e8617f}
+.rh-day.kind-internal{--rh-color:var(--ok)}
+.rh-head{display:flex;align-items:flex-start;gap:16px;width:100%;padding:16px 4px;border:0;background:none;font:inherit;text-align:start;cursor:pointer;color:inherit}
+.rh-head:focus-visible{outline:2px solid var(--gold-lit);outline-offset:-2px;border-radius:12px}
+.rh-rail{position:relative;display:flex;flex-direction:column;align-items:center;align-self:stretch;flex:none;width:34px}
+.rh-dot{display:grid;place-items:center;width:34px;height:34px;flex:none;border-radius:50%;border:1px solid var(--rh-color);color:var(--rh-color);background:rgba(13,5,24,.75);transition:.18s}
+.rh-line{flex:1;width:1px;min-height:14px;background:linear-gradient(var(--line-strong),var(--line))}
+.rh-day.open .rh-dot,.rh-head:hover .rh-dot{background:var(--rh-color);color:#150a22;box-shadow:0 0 0 5px color-mix(in srgb, var(--rh-color) 16%, transparent)}
+.rh-id{flex:1;min-width:0;display:grid;gap:4px;padding-block:2px}
+.rh-day-name{display:flex;align-items:center;gap:8px;color:var(--rh-color);font-size:.78rem;letter-spacing:.6px}
+.rh-flag{padding:1px 8px;border-radius:999px;font-size:.62rem;font-style:normal;letter-spacing:.4px}
+.rh-flag.now{background:var(--gold);color:#20130a;font-weight:700}
+.rh-flag.next{border:1px solid var(--line-strong);color:var(--lav-dim)}
+.rh-title{color:var(--ink);font-size:1.06rem;font-weight:700;line-height:1.5}
+.rh-lead{color:var(--lav);font-size:.88rem;line-height:1.75}
+.rh-num{flex:none;color:var(--line-strong);font-size:1.7rem;font-weight:800;line-height:1;transition:.18s}
+.rh-day.open .rh-num{color:color-mix(in srgb, var(--rh-color) 45%, transparent)}
+.rh-day.today>.rh-head .rh-title{color:var(--gold-lit)}
+.rh-body{margin-inline-start:50px;margin-bottom:16px;padding:15px 18px;border:1px solid var(--line);border-inline-start:3px solid var(--rh-color);border-radius:12px;background:rgba(13,5,24,.45);display:grid;gap:11px}
+.rh-body p{color:var(--ink);font-size:.93rem;line-height:1.95}
+.rh-bring{display:flex;gap:10px;flex-wrap:wrap;padding-top:10px;border-top:1px solid var(--line);color:var(--lav) !important;font-size:.86rem !important}
