     for (const key of ['name', 'seat', 'photo']) {
-      if (key in patch) {
-        member[key] = String(patch[key] ?? '');
-        member.placeholder = false;
-      }
+      if (key in patch) member[key] = String(patch[key] ?? '');
     }
