# Next.js collects anonymous usage telemetry by default. This project ships no
# analytics or telemetry of any kind, so turn it off for the app as well.
# Copy this file to .env (`cp .env.example .env`) before running.
NEXT_TELEMETRY_DISABLED=1

# Optional. Defaults to .data/orchestrator.db beside the project.
# ORCHESTRATOR_DB=.data/orchestrator.db

# Optional. Only "mock" is registered in milestone 1; "goose" lands in milestone 3.
# AGENT_RUNTIME=mock
