# Copy to .env before bringing the stack up.
#
#   http  (LAN / testing):  docker compose up -d --build
#   https (public server):  docker compose -f docker-compose.https.yml up -d --build

# --- admin console (#/admin) -------------------------------------------------
ADMIN_USER=nimbo
ADMIN_PASSWORD=change-me

# Signs the session tokens. Generate with: openssl rand -hex 32
# Changing it invalidates every open session; nobody has to type it, so make it long.
SESSION_SECRET=change-me-too

# --- staff logins (#/panel) --------------------------------------------------
# The roster — who exists, which team they mentor — lives in the code.
# The passwords live only here. These two are the shared fallbacks.
MENTOR_PASSWORD=change-me-mentor
LEAD_PASSWORD=change-me-lead

# Any account can be given its own password instead, which beats the shared one.
# Usernames: saleh, asgarian, tarkashvand, amir (mentors) and lead.
# Leaving one blank is fine — it falls back to MENTOR_PASSWORD / LEAD_PASSWORD.
STAFF_PASSWORD_SALEH=
STAFF_PASSWORD_ASGARIAN=
STAFF_PASSWORD_TARKASHVAND=
STAFF_PASSWORD_AMIR=
STAFF_PASSWORD_LEAD=

# --- http mode only ----------------------------------------------------------
# Port the site answers on. Ignored in https mode, where 80 and 443 are used.
WEB_PORT=8088

# --- https mode only ---------------------------------------------------------
# The hostname the site answers on and Caddy takes a certificate for. It must
# already point at this server's IP, and ports 80 and 443 must be reachable:
# 443 serves the site, 80 is how Let's Encrypt verifies you own the name.
# No domain? A free subdomain from duckdns.org works.
SITE_DOMAIN=nimbo.example.com

# Let's Encrypt account address. Certificate expiry warnings go here.
SITE_EMAIL=
