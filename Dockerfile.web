# Build the site against the API, then hand the static files to nginx.
FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./

# Use an Iranian NPM mirror to avoid registry connectivity issues.
RUN npm config set registry https://mirror-npm.runflare.com \
    && npm config set strict-ssl false \
    && npm ci --no-audit --no-fund

COPY . .

# Served from the container root, and pointed at the API through the same origin.
ENV VITE_BASE=/ \
    VITE_API_BASE=/

RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

